{
    "name": "Indic Translation API Development",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "backend",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "visualstudioexptteam.vscodeintellicode",
                "dbaeumer.vscode-eslint",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.pythonPath": "/app/.venv/bin/python"
            }
        }
    },
    "forwardPorts": [
        8000
    ]
}
